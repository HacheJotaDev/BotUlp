# ════════════════════════════════════════════
#  HJ ULP PRO v4.0 — Variables de entorno
# ════════════════════════════════════════════
#
#  1) Copia este archivo:  cp .env.example .env
#  2) Rellena tus valores (sin comillas)
#  3) El archivo .env ya está en .gitignore, no se sube al repo
#

# ── Telegram (OBLIGATORIO) ────────────────────
BOT_TOKEN=tu_token_aqui

# Credenciales de https://my.telegram.org
API_ID=tu_api_id
API_HASH=tu_api_hash

# ── Administración ────────────────────────────
# IDs separados por coma
ADMIN_IDS=1234567890

# ── Identidad del bot ─────────────────────────
BOT_USERNAME=UlpHJBot
SUPPORT_CONTACT=hjofc20

# ── Base de datos PostgreSQL (OBLIGATORIO) ───
#  URL completa del pooler de Neon (o cualquier Postgres).
#  El bot crea las tablas automáticamente al arrancar.
DATABASE_URL=postgresql://usuario:password@ep-tu-host-pooler.region.aws.neon.tech/nombre_bd?sslmode=require

# ── NOWPayments (pagos automáticos) ──────────
NOWPAYMENTS_API_KEY=tu_api_key
NOWPAYMENTS_IPN_KEY=tu_ipn_secret

# ⚡ IPN URL — AUTO-DETECCIÓN DE IP DEL VPS
#    · "auto"  (recomendado)  → detecta la IP pública al arrancar
#    · vacío                   → también auto-detecta
#    · http://1.2.3.4:9090/ipn → fuerza una IP/URL concreta (dominio, proxy…)
#    Ideal si cambiás de VPS seguido: no tocás nada, el bot se encarga.
NOWPAYMENTS_IPN_URL=auto
NOWPAYMENTS_WEBHOOK_PORT=9090

# ── Actualización remota (/updateBot) ────────
# Nombres pm2 separados por coma (se prueba cada uno)
PM2_NAME=botulp,ulp-bot

# ── Emojis premium (opcional) ────────────────
# 1 = activados (por defecto) · 0 = emojis normales
# Cubre los 86 custom emojis en TODOS los mensajes y los iconos
# premium de los botones inline/URL compatibles.
# NOTA: requieren un username coleccionable de Fragment en el bot.
# Si el servidor los rechaza, el bot los desactiva solo al arrancar
# (queda anotado en el log y todo sigue funcionando con normalidad).
PREMIUM_EMOJIS=1

# ── Rendimiento (opcional) ────────────────────
# Segundos de caché de usuarios en RAM
USER_CACHE_TTL=30

# ── Limpieza inteligente de mensajes (v4.3.1, opcional) ──
# 1 = el bot borra sus avisos temporales ya cumplidos (por defecto)
# 0 = desactivado por completo (todos los mensajes se quedan)
AUTO_CLEAN_MESSAGES=1
# Avisos de carga/cola obsoletos, en segundos (rango orientativo 5-15)
AUTO_CLEAN_TEMP_SECONDS=10
# Confirmaciones/avisos informativos ya cumplidos (rango 60-120)
AUTO_CLEAN_INFO_SECONDS=90
# SOLO se borran mensajes que el propio bot registra como temporales:
# resultados, archivos, pagos, membresías, errores, menús con botones
# y notificaciones a administradores NUNCA se tocan.
